# Copy file này thành .env rồi điền giá trị thật:  cp .env.example .env
# docker compose và run.sh tự đọc file .env ở thư mục gốc

# Cấu hình Database
DB_NAME=banking_db
DB_USER=your_db_user
DB_PASS=your_db_password

# Chỉ dùng cho docker-compose-bai1..4.yml (các bài trung gian có mở port ra host)
DB_PORT=5433
APP_PORT=8080
